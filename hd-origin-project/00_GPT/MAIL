.badge--new::before {
  content: "";
  position: absolute;
  inset-block: -20%;
  inset-inline-start: -40%;
  inline-size: 42%;
  background:
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.88) 50%,
