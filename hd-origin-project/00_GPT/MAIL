  <script>
(() => {
  "use strict";

  const views = [...document.querySelectorAll(".app-view")];
  const tabs = [...document.querySelectorAll(".tab")];
  const cards = [...document.querySelectorAll(".mail-card")];

  const body = document.body;
  const menuButton = document.getElementById("menuButton");
  const menuClose = document.getElementById("menuClose");
  const menuPanel = document.getElementById("menuPanel");
  const menuBackdrop = document.getElementById("menuBackdrop");
  const refreshButton = document.getElementById("refreshButton");
  const settingsButton = document.getElementById("settingsButton");
  const sendButton = document.getElementById("sendButton");
  const sendResult = document.getElementById("sendResult");

  function showView(viewName) {
    const nextView = views.find(
      (view) => view.dataset.view === viewName
    );

    if (!nextView) {
      return;
    }

    views.forEach((view) => {
      view.classList.toggle("is-active", view === nextView);
    });

    closeMenu();
    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });
  }

  function animateVisibleCards(filter = "all") {
    let visibleIndex = 0;

    cards.forEach((card) => {
      const status = card.dataset.status;
      const visible = filter === "all" || status === filter;

      card.classList.remove("from-left", "from-right");

      if (!visible) {
        card.classList.add("is-hidden");
        card.style.animationDelay = "";
        return;
      }

      card.classList.remove("is-hidden");
      void card.offsetWidth;

      const animationClass =
        visibleIndex % 2 === 0
          ? "from-left"
          : "from-right";

      card.classList.add(animationClass);
      card.style.animationDelay =
        `${0.12 + visibleIndex * 0.1}s`;

      visibleIndex += 1;
    });
  }

  function applyFilter(filter) {
    tabs.forEach((tab) => {
      tab.classList.toggle(
        "active",
        tab.dataset.filter === filter
      );
    });

    animateVisibleCards(filter);
  }

  function openMenu() {
    if (!menuPanel || !menuBackdrop || !menuButton) {
      return;
    }

    body.classList.add("menu-open");
    menuPanel.classList.add("is-open");
    menuPanel.setAttribute("aria-hidden", "false");

    menuButton.setAttribute("aria-expanded", "true");

    menuBackdrop.hidden = false;

    requestAnimationFrame(() => {
      menuBackdrop.classList.add("is-visible");
    });
  }

  function closeMenu() {
    if (!menuPanel || !menuBackdrop || !menuButton) {
      return;
    }

    body.classList.remove("menu-open");
    menuPanel.classList.remove("is-open");
    menuPanel.setAttribute("aria-hidden", "true");

    menuButton.setAttribute("aria-expanded", "false");
    menuBackdrop.classList.remove("is-visible");

    window.setTimeout(() => {
      if (!menuPanel.classList.contains("is-open")) {
        menuBackdrop.hidden = true;
      }
    }, 460);
  }

  document.querySelectorAll("[data-view-link]").forEach(
    (element) => {
      element.addEventListener("click", () => {
        showView(element.dataset.viewLink);
      });
    }
  );

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      applyFilter(tab.dataset.filter || "all");
    });
  });

  if (menuButton) {
    menuButton.addEventListener("click", openMenu);
  }

  if (menuClose) {
    menuClose.addEventListener("click", closeMenu);
  }

  if (menuBackdrop) {
    menuBackdrop.addEventListener("click", closeMenu);
  }

  if (refreshButton) {
    refreshButton.addEventListener("click", () => {
      const activeTab = document.querySelector(".tab.active");
      const filter = activeTab
        ? activeTab.dataset.filter
        : "all";

      animateVisibleCards(filter);
      closeMenu();
    });
  }

  if (settingsButton) {
    settingsButton.addEventListener("click", () => {
      closeMenu();
    });
  }

  if (sendButton && sendResult) {
    sendButton.addEventListener("click", () => {
      sendResult.classList.add("is-visible");

      window.setTimeout(() => {
        sendResult.classList.remove("is-visible");
      }, 2800);
    });
  }

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMenu();
    }
  });

  applyFilter("all");
})();
  </script>
<!-- hd-origin-style-mail-wix-bridge-start -->
<script>
(() => {
  "use strict";

  const SYSTEM = "HD_ORIGIN_STYLE_MAIL_SYSTEM";

  const state = {
    messages: [],
    selectedMessage: null,
    pageIndex: 0,
    pageTokens: [""],
    nextPageToken: "",
    totalPages: 1,
    paginationLoading: false,
    pageReady: false,
    backendConnected: false,
    googleWorkspaceConnected: false
  };

  const postToWix = (type, payload = {}) => {
    window.parent.postMessage(
      {
        system: SYSTEM,
        type,
        payload
      },
      "*"
    );
  };

  const showResult = (text, isError = false) => {
    const result = document.getElementById("sendResult");

    if (!result) {
      return;
    }

    result.textContent = text;
    result.dataset.resultType = isError ? "error" : "success";
    result.classList.add("is-visible");

    window.setTimeout(() => {
      result.classList.remove("is-visible");
    }, 3200);
  };

  const formatTime = (value) => {
    if (!value) {
      return "";
    }

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return "";
    }

    const parts =
      new Intl.DateTimeFormat("ja-JP", {
        timeZone: "Asia/Tokyo",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        weekday: "short",
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23"
      }).formatToParts(date);

    const getPart = (type) =>
      parts.find((part) => part.type === type)?.value || "";

    return (
      `${getPart("year")}/` +
      `${getPart("month")}/` +
      `${getPart("day")}` +
      `（${getPart("weekday")}） ` +
      `${getPart("hour")}:` +
      `${getPart("minute")}`
    );
  };

  const statusLabel = (status) => {
    switch (status) {
      case "new":
        return "未読";

      case "progress":
        return "既読";

      case "done":
        return "完了";

      default:
        return "未読";
    }
  };

  const badgeHtml = (message) => {
    if (message.status === "new") {
      return '<span class="badge badge--new">NEW</span>';
    }

    if (message.status === "progress") {
      return '<span class="badge badge--progress">既読</span>';
    }

    return '<span class="badge badge--done">完了</span>';
  };

  const escapeHtml = (value) => {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  };

  const createMailCard = (message) => {
    const card = document.createElement("div");

    card.className =
      message.status === "new"
        ? "mail-card is-new"
        : "mail-card";

    card.dataset.status = message.status || "new";
    card.dataset.messageId = message.id || "";

    card.innerHTML = `
      <span class="mail-card__accent"></span>

      <span class="mail-card__head">
        <span class="mail-card__badges">
          ${badgeHtml(message)}
          <span class="badge badge--store">Rasiːm</span>
        </span>

        <span class="mail-card__time">
          ${escapeHtml(formatTime(message.receivedAt))}
        </span>
      </span>

      <span class="mail-card__body">
        <span class="mail-card__from">
          ${escapeHtml(message.fromName || message.fromEmail)}
        </span>

        <span class="mail-card__subject">
          ${escapeHtml(message.subject)}
        </span>

        <span class="mail-card__preview">
          ${escapeHtml(message.preview || message.body)}
        </span>
      </span>

      <span class="mail-card__foot">
        <span class="state state--${escapeHtml(message.status || "new")}">
          ${escapeHtml(statusLabel(message.status))}
        </span>

        ${
          message.status === "done"
            ? `
              <span class="mail-card__completed">
                完了済み
              </span>
            `
            : `
              <button
                class="mail-card__complete"
                type="button">
                完了にする
              </button>
            `
        }
      </span>
    `;

    const completeButton =
      card.querySelector(".mail-card__complete");

    if (completeButton) {
      completeButton.addEventListener(
        "click",
        (event) => {
          event.stopPropagation();

          const confirmed =
            window.confirm(
              "このメールを完了にしますか？"
            );

          if (!confirmed) {
            return;
          }

          message.status = "done";

          postToWix(
            "HD_ORIGIN_STYLE_MAIL_UPDATE_STATUS",
            {
              messageId: message.id,
              status: "done"
            }
          );

          renderMessages(state.messages);
        }
      );
    }

    card.addEventListener("click", () => {
      openMessage(message);
    });

    return card;
  };

  const updateMetrics = (messages) => {
    const newCount = messages.filter(
      (message) => message.status === "new"
    ).length;

    const progressCount = messages.filter(
      (message) => message.status === "progress"
    ).length;

    const metricValues =
      document.querySelectorAll(".metric__value");

    if (metricValues[0]) {
      metricValues[0].textContent = String(newCount);
    }

    if (metricValues[1]) {
      metricValues[1].textContent = String(progressCount);
    }

    const heroChip = document.querySelector(".hero-chip");

    if (heroChip) {
      heroChip.textContent = `新着 ${newCount}`;
    }
  };

  const renderMessages = (messages) => {
    const list = document.querySelector(".mail-list");

    if (!list) {
      return;
    }

    list.innerHTML = "";

    messages.forEach((message) => {
      list.appendChild(createMailCard(message));
    });

    updateMetrics(messages);

    const activeTab = document.querySelector(".tab.active");
    const currentFilter =
      activeTab?.dataset.filter || "all";

    applyCurrentFilter(currentFilter);
  };

  const applyCurrentFilter = (filter) => {
    document.querySelectorAll(".mail-card").forEach((card) => {
      const visible =
        filter === "all" ||
        card.dataset.status === filter;

      card.classList.toggle("is-hidden", !visible);
    });
  };

  const updatePagination = () => {
    const previousButton =
      document.getElementById(
        "previousPageButton"
      );

    const nextButton =
      document.getElementById(
        "nextPageButton"
      );

    const pageLabel =
      document.getElementById(
        "mailPageLabel"
      );

    if (previousButton) {
      previousButton.disabled =
        state.paginationLoading ||
        state.pageIndex === 0;
    }

    if (nextButton) {
      nextButton.disabled =
        state.paginationLoading ||
        !state.nextPageToken;
    }

    if (pageLabel) {
      pageLabel.textContent =
        `${state.pageIndex + 1}/${state.totalPages}ページ`;
    }
  };

  const requestMailPage = (pageIndex) => {
    if (
      pageIndex < 0 ||
      state.paginationLoading
    ) {
      return;
    }

    const pageToken =
      String(
        state.pageTokens[pageIndex] || ""
      );

    if (
      pageIndex > 0 &&
      !pageToken
    ) {
      return;
    }

    state.pageIndex = pageIndex;
    state.paginationLoading = true;

    updatePagination();

    postToWix(
      "HD_ORIGIN_STYLE_MAIL_REQUEST_MESSAGES",
      {
        pageToken
      }
    );
  };

  const openMessage = (message) => {
    if (message.status === "new") {
      message.status = "progress";

      postToWix("HD_ORIGIN_STYLE_MAIL_UPDATE_STATUS", {
        messageId: message.id,
        status: "progress"
      });

      renderMessages(state.messages);
    }

    state.selectedMessage = message;

    if (!message.detailLoaded) {
      postToWix(
        "HD_ORIGIN_STYLE_MAIL_REQUEST_DETAIL",
        {
          messageId: message.id
        }
      );
    }

    const subject =
      document.querySelector("#viewDetail .detail-subject");

    const metaValues =
      document.querySelectorAll("#viewDetail .meta-row dd");

    const messageBox =
      document.querySelector("#viewDetail .message-box");

    const completeButton =
      document.getElementById("completeButton");

    const replyTo =
      document.querySelector(
        "#viewReply .reply-fixed__row:nth-child(2) " +
        ".reply-fixed__value"
      );

    const replySubject =
      document.querySelector("#viewReply .input");

    const replyBody =
      document.querySelector("#viewReply .textarea--large");

    if (subject) {
      subject.textContent = message.subject || "";
    }

    if (metaValues[0]) {
      metaValues[0].textContent =
        `${message.fromName || ""} <${message.fromEmail || ""}>`;
    }

    if (metaValues[1]) {
      metaValues[1].textContent =
        message.toEmail || "rasi-m@hatodaiya.com";
    }

    if (metaValues[2]) {
      metaValues[2].textContent =
        statusLabel(message.status);
    }

    if (metaValues[3]) {
      metaValues[3].textContent =
        message.assignee || "未割当";
    }

    if (messageBox) {
      if (!message.detailLoaded) {
        messageBox.textContent =
          "メールを読み込んでいます...";
      } else {
        const threadMessages =
          Array.isArray(message.threadMessages) &&
          message.threadMessages.length > 0
            ? message.threadMessages
            : [
                {
                  direction: "incoming",
                  fromName: message.fromName,
                  fromEmail: message.fromEmail,
                  body: message.body,
                  receivedAt: message.receivedAt
                }
              ];

        messageBox.innerHTML = "";

        threadMessages.forEach((threadMessage) => {
          const article =
            document.createElement("article");

          article.className =
            threadMessage.direction === "outgoing"
              ? "thread-message thread-message--outgoing"
              : "thread-message thread-message--incoming";

          const meta =
            document.createElement("div");

          meta.className =
            "thread-message__meta";

          const sender =
            document.createElement("span");

          sender.className =
            "thread-message__sender";

          sender.textContent =
            threadMessage.direction === "outgoing"
              ? "Rasiːm"
              : (
                  threadMessage.fromName ||
                  threadMessage.fromEmail ||
                  ""
                );

          if (
            threadMessage.direction === "incoming" &&
            threadMessage.status === "new"
          ) {
            const unreadBadge =
              document.createElement("span");

            unreadBadge.className =
              "thread-message__unread";

            unreadBadge.textContent =
              "未読";

            sender.appendChild(unreadBadge);
          }

          const date =
            document.createElement("span");

          if (threadMessage.receivedAt) {
            const value =
              new Date(threadMessage.receivedAt);

            date.textContent =
              Number.isNaN(value.getTime())
                ? ""
                : value.toLocaleString("ja-JP");
          }

          meta.appendChild(sender);
          meta.appendChild(date);

          const body =
            document.createElement("div");

          body.className =
            "thread-message__body";

          body.textContent =
            threadMessage.body || "";

          article.appendChild(meta);
          article.appendChild(body);

          messageBox.appendChild(article);
        });
      }
    }

    if (completeButton) {
      const completed =
        message.status === "done";

      completeButton.disabled =
        completed;

      completeButton.textContent =
        completed
          ? "完了済"
          : "完了";
    }

    if (replyTo) {
      replyTo.textContent = message.fromEmail || "";
    }

    if (replySubject) {
      const currentSubject = message.subject || "";
      replySubject.value =
        currentSubject.startsWith("Re:")
          ? currentSubject
          : `Re: ${currentSubject}`;
    }

    if (replyBody) {
      const recipient =
        message.fromName
          ? `${message.fromName}様`
          : "";

      replyBody.value =
`${recipient}

お問い合わせありがとうございます。
内容を確認のうえ、ご連絡いたします。

Rasiːm`;
    }

    const detailView =
      document.querySelector('[data-view="detail"]');

    document.querySelectorAll(".app-view").forEach((view) => {
      view.classList.toggle(
        "is-active",
        view === detailView
      );
    });

    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });
  };


  const sendReply = () => {
    if (!state.selectedMessage) {
      showResult(
        "返信対象のメールが選択されていません。",
        true
      );
      return;
    }

    const subject =
      document.querySelector("#viewReply .input")?.value || "";

    const body =
      document.querySelector(
        "#viewReply .textarea--large"
      )?.value || "";

    if (!body.trim()) {
      showResult(
        "返信本文を入力してください。",
        true
      );
      return;
    }

    postToWix(
      "HD_ORIGIN_STYLE_MAIL_SEND_REPLY",
      {
        messageId: state.selectedMessage.id,
        subject,
        body
      }
    );
  };

  window.addEventListener("message", (event) => {
    const message = event.data;

    if (
      !message ||
      typeof message !== "object" ||
      typeof message.type !== "string"
    ) {
      return;
    }

    const payload = message.payload || {};

    switch (message.type) {
      case "HD_ORIGIN_STYLE_MAIL_PAGE_READY":
        state.pageReady = true;
        state.backendConnected =
          Boolean(payload.backendConnected);

        state.googleWorkspaceConnected =
          Boolean(payload.googleWorkspaceConnected);

        postToWix(
          "HD_ORIGIN_STYLE_MAIL_REQUEST_MESSAGES"
        );
        break;

      case "HD_ORIGIN_STYLE_MAIL_MESSAGES_RESULT":
        if (!payload.ok) {
          showResult(
            `メール一覧取得失敗: ${
              payload.error || "UNKNOWN_ERROR"
            }`,
            true
          );
          return;
        }

        state.totalPages =
          Math.max(
            1,
            Math.ceil(
              Number(
                payload.resultSizeEstimate || 0
              ) / 20
            )
          );

        {
          const receivedMessages =
            Array.isArray(payload.messages)
              ? payload.messages
              : [];

          const threadMap = new Map();

          receivedMessages.forEach((message) => {
            const threadKey =
              String(
                message.threadId ||
                message.id ||
                ""
              );

            const current =
              threadMap.get(threadKey);

            if (!current) {
              threadMap.set(
                threadKey,
                message
              );
              return;
            }

            const currentTime =
              new Date(
                current.receivedAt || 0
              ).getTime();

            const messageTime =
              new Date(
                message.receivedAt || 0
              ).getTime();

            if (messageTime > currentTime) {
              threadMap.set(
                threadKey,
                message
              );
            }
          });

          state.messages =
            [...threadMap.values()]
              .sort((a, b) =>
                new Date(
                  b.receivedAt || 0
                ).getTime() -
                new Date(
                  a.receivedAt || 0
                ).getTime()
              );
        }

        state.nextPageToken =
          String(
            payload.nextPageToken || ""
          );

        state.paginationLoading = false;

        if (state.nextPageToken) {
          state.pageTokens[
            state.pageIndex + 1
          ] = state.nextPageToken;
        } else {
          state.pageTokens.splice(
            state.pageIndex + 1
          );
        }

        renderMessages(state.messages);
        updatePagination();
        break;

      case "HD_ORIGIN_STYLE_MAIL_DETAIL_RESULT":
        if (
          !payload.ok ||
          !payload.message ||
          !state.selectedMessage
        ) {
          showResult(
            `メール本文取得失敗: ${
              payload.error || "UNKNOWN_ERROR"
            }`,
            true
          );
          return;
        }

        if (
          String(state.selectedMessage.id || "") !==
          String(payload.message.id || "")
        ) {
          return;
        }

        {
          const currentStatus =
            state.selectedMessage.status;

          Object.assign(
            state.selectedMessage,
            payload.message
          );

          state.selectedMessage.status =
            currentStatus;

          const threadMessages =
            Array.isArray(payload.message.threadMessages)
              ? payload.message.threadMessages
              : [];

          const latestIncoming =
            threadMessages
              .filter(
                (threadMessage) =>
                  threadMessage.direction === "incoming"
              )
              .sort(
                (a, b) =>
                  new Date(a.receivedAt || 0).getTime() -
                  new Date(b.receivedAt || 0).getTime()
              )
              .at(-1);

          if (
            latestIncoming &&
            latestIncoming.status === "new" &&
            String(latestIncoming.id || "") !==
              String(state.selectedMessage.id || "")
          ) {
            const threadId =
              String(
                payload.message.threadId ||
                state.selectedMessage.threadId ||
                ""
              );

            const messageIndex =
              state.messages.findIndex((message) => {
                if (
                  threadId &&
                  String(message.threadId || "") === threadId
                ) {
                  return true;
                }

                return (
                  String(message.id || "") ===
                  String(state.selectedMessage.id || "")
                );
              });

            if (messageIndex >= 0) {
              const currentMessage =
                state.messages[messageIndex];

              state.messages[messageIndex] = {
                ...currentMessage,
                id: latestIncoming.id,
                threadId,
                status: "new",
                fromName:
                  latestIncoming.fromName ||
                  currentMessage.fromName,
                fromEmail:
                  latestIncoming.fromEmail ||
                  currentMessage.fromEmail,
                toEmail:
                  latestIncoming.toEmail ||
                  currentMessage.toEmail,
                preview:
                  latestIncoming.body ||
                  currentMessage.preview,
                body:
                  latestIncoming.body || "",
                receivedAt:
                  latestIncoming.receivedAt ||
                  currentMessage.receivedAt,
                detailLoaded: true,
                threadMessages
              };

              renderMessages(state.messages);
            }
          }

          openMessage(state.selectedMessage);
        }
        break;

      case "HD_ORIGIN_STYLE_MAIL_SEND_REPLY_RESULT":
        if (!payload.ok) {
          if (
            payload.error ===
            "GOOGLE_WORKSPACE_NOT_CONNECTED"
          ) {
            showResult(
              "Google Workspaceはまだ接続されていません。",
              true
            );
            return;
          }

          showResult(
            `返信処理失敗: ${
              payload.error || "UNKNOWN_ERROR"
            }`,
            true
          );
          return;
        }

        showResult("返信を送信しました。");

        if (state.selectedMessage) {
          state.selectedMessage.detailLoaded = false;

          const detailView =
            document.querySelector(
              '[data-view="detail"]'
            );

          document
            .querySelectorAll(".app-view")
            .forEach((view) => {
              view.classList.toggle(
                "is-active",
                view === detailView
              );
            });

          postToWix(
            "HD_ORIGIN_STYLE_MAIL_REQUEST_DETAIL",
            {
              messageId:
                state.selectedMessage.id
            }
          );
        }

        break;

      case "HD_ORIGIN_STYLE_MAIL_ERROR":
        showResult(
          payload.message ||
          payload.error ||
          "Wix側でエラーが発生しました。",
          true
        );
        break;
    }
  });

  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".tab").forEach((tab) => {
      tab.addEventListener("click", () => {
        const filter = tab.dataset.filter || "all";

        document.querySelectorAll(".tab").forEach(
          (target) => {
            target.classList.toggle(
              "active",
              target === tab
            );
          }
        );

        applyCurrentFilter(filter);
      });
    });

    const previousPageButton =
      document.getElementById(
        "previousPageButton"
      );

    const nextPageButton =
      document.getElementById(
        "nextPageButton"
      );

    if (previousPageButton) {
      previousPageButton.addEventListener(
        "click",
        () => {
          requestMailPage(
            state.pageIndex - 1
          );
        }
      );
    }

    if (nextPageButton) {
      nextPageButton.addEventListener(
        "click",
        () => {
          if (!state.nextPageToken) {
            return;
          }

          state.pageTokens[
            state.pageIndex + 1
          ] = state.nextPageToken;

          requestMailPage(
            state.pageIndex + 1
          );
        }
      );
    }

    updatePagination();


    const sendButton =
      document.getElementById("sendButton");

    if (sendButton) {
      const replacement =
        sendButton.cloneNode(true);

      sendButton.replaceWith(replacement);
      replacement.addEventListener("click", sendReply);
    }

    window.setTimeout(() => {
      postToWix("HD_ORIGIN_STYLE_MAIL_READY");
    }, 250);
  });
})();
</script>
<!-- hd-origin-style-mail-wix-bridge-end -->
</body>
</html>