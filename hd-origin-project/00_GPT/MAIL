<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>HD ORGIN STYLE MAIL SYSTEM</title>
  <style>
:root {
  --color-bg: #ffffff;
  --color-bg-soft: #fbfcff;
  --color-surface: #ffffff;
  --color-surface-violet: #faf7ff;
  --color-surface-blue: #f4f8ff;

  --color-text: #343b61;
  --color-text-strong: #252d55;
  --color-text-soft: #77809f;
  --color-text-muted: #9299b2;

  --color-line: rgba(190, 199, 232, 0.76);
  --color-line-strong: rgba(168, 180, 224, 0.88);

  --color-violet: #826fc8;
  --color-violet-soft: #eee9ff;
  --color-blue: #719fdc;
  --color-blue-soft: #eaf3ff;

  --color-new: #9d5872;
  --color-new-bg: #ffeaf1;
  --color-new-line: #e8b8c9;

  --color-progress: #916725;
  --color-progress-bg: #fff1cb;
  --color-progress-line: #e9cd84;

  --color-done: #477b60;
  --color-done-bg: #e1f4e8;
  --color-done-line: #afd7bd;

  --shadow-soft: 0 0.375rem 1rem rgba(150, 162, 207, 0.1);
  --shadow-card: 0 0.625rem 1.375rem rgba(150, 162, 207, 0.12);
  --shadow-panel: 0 1rem 2.25rem rgba(134, 146, 195, 0.15);

  --radius-xs: 0.625rem;
  --radius-sm: 0.75rem;
  --radius-md: 0.9375rem;
  --radius-lg: 1.125rem;
  --radius-pill: 999rem;

  --font-2xs: 0.625rem;
  --font-xs: 0.6875rem;
  --font-sm: 0.75rem;
  --font-md: 0.8125rem;
  --font-lg: 0.9375rem;
  --font-xl: 1.0625rem;

  --shell-width: 27rem;
  --tap-size: 2.375rem;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  font-size: 100%;
  background: var(--color-bg);
  -webkit-text-size-adjust: 100%;
}

body {
  min-height: 100vh;
  margin: 0;
  overflow-x: hidden;
  color: var(--color-text);
  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(218, 230, 255, 0.2),
      transparent 23%
    ),
    radial-gradient(
      circle at 0% 0%,
      rgba(236, 229, 255, 0.18),
      transparent 20%
    ),
    linear-gradient(
      180deg,
      #ffffff 0%,
      #fdfdff 48%,
      #fbfcff 100%
    );
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    "Hiragino Sans",
    "Yu Gothic UI",
    "Yu Gothic",
    Meiryo,
    sans-serif;
  font-size: var(--font-md);
  line-height: 1.55;
  opacity: 0;
  transform: translateY(0.5rem);
  transition:
    opacity 0.58s cubic-bezier(0.22, 1, 0.36, 1),
    transform 0.58s cubic-bezier(0.22, 1, 0.36, 1);
}

body.is-loaded {
  opacity: 1;
  transform: translateY(0);
}

body.is-leaving {
  opacity: 0;
  transform: translateY(0.375rem);
}

body.menu-open {
  overflow: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

button,
a,
input,
textarea {
  -webkit-tap-highlight-color: transparent;
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
textarea:focus-visible {
  outline: 0.125rem solid rgba(117, 142, 215, 0.42);
  outline-offset: 0.125rem;
}

.app-shell {
  width: min(100%, var(--shell-width));
  min-height: 100vh;
  margin: 0 auto;
  padding:
    max(0.75rem, env(safe-area-inset-top))
    0.75rem
    max(1.25rem, env(safe-area-inset-bottom));
}

.topbar,
.subbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  margin-bottom: 0.625rem;
}

.topbar {
  align-items: flex-start;
}

.brand-block,
.subbar__text {
  min-inline-size: 0;
}

.eyebrow {
  margin: 0 0 0.125rem;
  overflow: hidden;
  color: #746d99;
  font-size: 0.5625rem;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 0.13em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-name {
  margin: 0;
  color: var(--color-text-strong);
  font-size: 1rem;
  font-weight: 750;
  line-height: 1.2;
  letter-spacing: 0.01em;
}

.shop-mail {
  margin: 0.125rem 0 0;
  overflow: hidden;
  color: var(--color-text-soft);
  font-size: var(--font-xs);
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.icon-button {
  flex: 0 0 auto;
  inline-size: var(--tap-size);
  block-size: var(--tap-size);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0.0625rem solid var(--color-line);
  border-radius: 0.8125rem;
  color: #62598e;
  background:
    linear-gradient(
      180deg,
      #ffffff 0%,
      #f7f4ff 100%
    );
  box-shadow: var(--shadow-soft);
  transition:
    transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
    border-color 0.28s ease,
    background 0.28s ease;
}

.icon-button:hover {
  border-color: var(--color-line-strong);
  background:
    linear-gradient(
      180deg,
      #ffffff 0%,
      #f0ecff 100%
    );
}

.icon-button:active {
  transform: scale(0.96);
}

.icon-button--soft {
  inline-size: 2.25rem;
  block-size: 2.25rem;
}

.icon {
  inline-size: 1rem;
  block-size: 1rem;
}

.hero {
  padding: 0.6875rem 0.75rem;
  border: 0.0625rem solid var(--color-line);
  border-radius: var(--radius-lg);
  background:
    radial-gradient(
      circle at 12% 18%,
      rgba(255, 255, 255, 0.76),
      transparent 23%
    ),
    radial-gradient(
      circle at 88% 14%,
      rgba(214, 231, 255, 0.45),
      transparent 25%
    ),
    linear-gradient(
      135deg,
      #ffffff 0%,
      #f7f2ff 40%,
      #edf5ff 78%,
      #ffffff 100%
    );
  box-shadow: var(--shadow-card);
}

.hero__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.625rem;
  margin-bottom: 0.5625rem;
}

.hero__label {
  margin: 0 0 0.0625rem;
  color: #8076a8;
  font-size: var(--font-2xs);
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: 0.12em;
}

.hero__title {
  margin: 0;
  color: var(--color-text-strong);
  font-size: var(--font-lg);
  font-weight: 750;
  line-height: 1.3;
}

.hero-chip {
  min-block-size: 1.375rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 0.5rem;
  border: 0.0625rem solid rgba(184, 176, 228, 0.82);
  border-radius: var(--radius-pill);
  color: #6f5e9c;
  background:
    linear-gradient(
      180deg,
      #ffffff 0%,
      #efeaff 100%
    );
  font-size: var(--font-2xs);
  font-weight: 750;
  white-space: nowrap;
}

.hero-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.375rem;
}

.metric {
  min-inline-size: 0;
  padding: 0.5rem 0.5625rem;
  border: 0.0625rem solid var(--color-line);
  border-radius: var(--radius-sm);
  box-shadow: 0 0.25rem 0.75rem rgba(151, 164, 208, 0.08);
}

.metric--new {
  background:
    linear-gradient(
      180deg,
      #fff5f8 0%,
      #ffedf3 100%
    );
}

.metric--progress {
  background:
    linear-gradient(
      180deg,
      #fff9e9 0%,
      #fff2d3 100%
    );
}

.metric--staff {
  background:
    linear-gradient(
      180deg,
      #f3f7ff 0%,
      #eaf1ff 100%
    );
}

.metric__label {
  margin: 0 0 0.0625rem;
  overflow: hidden;
  color: var(--color-text-soft);
  font-size: var(--font-2xs);
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric__value {
  margin: 0;
  overflow: hidden;
  color: var(--color-text-strong);
  font-size: 0.875rem;
  font-weight: 750;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric__value--name {
  font-size: 0.75rem;
}

.tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.375rem;
  margin: 0.625rem 0;
}

.tab {
  min-inline-size: 0;
  min-block-size: 2.125rem;
  padding: 0 0.3125rem;
  border: 0.0625rem solid var(--color-line);
  border-radius: var(--radius-sm);
  color: #626b8b;
  background:
    linear-gradient(
      180deg,
      #ffffff 0%,
      #fafbff 100%
    );
  box-shadow: 0 0.1875rem 0.625rem rgba(150, 163, 207, 0.06);
  font-size: var(--font-sm);
  font-weight: 750;
  white-space: nowrap;
  transition:
    transform 0.24s cubic-bezier(0.22, 1, 0.36, 1),
    border-color 0.24s ease,
    box-shadow 0.24s ease,
    background 0.24s ease;
}

.tab:active {
  transform: scale(0.975);
}

.tab[data-filter="new"] {
  color: var(--color-new);
  border-color: var(--color-new-line);
  background:
    linear-gradient(
      180deg,
      #fff7f9 0%,
      #fff0f4 100%
    );
}

.tab[data-filter="progress"] {
  color: var(--color-progress);
  border-color: var(--color-progress-line);
  background:
    linear-gradient(
      180deg,
      #fffaf0 0%,
      #fff4db 100%
    );
}

.tab[data-filter="done"] {
  color: var(--color-done);
  border-color: var(--color-done-line);
  background:
    linear-gradient(
      180deg,
      #f3fbf6 0%,
      #e9f7ee 100%
    );
}

.tab.active {
  box-shadow: var(--shadow-soft);
}

.tab.active[data-filter="all"] {
  color: #63518f;
  border-color: rgba(177, 167, 225, 0.94);
  background:
    linear-gradient(
      180deg,
      #f2eeff 0%,
      #e9e3ff 100%
    );
}

.tab.active[data-filter="new"] {
  color: #8f4f67;
  border-color: #dfa8bc;
  background:
    linear-gradient(
      180deg,
      #ffe8ef 0%,
      #ffdde7 100%
    );
}

.tab.active[data-filter="progress"] {
  color: #855c1f;
  border-color: #e2bd65;
  background:
    linear-gradient(
      180deg,
      #ffefc5 0%,
      #ffe2a8 100%
    );
}

.tab.active[data-filter="done"] {
  color: #407359;
  border-color: #96cbaa;
  background:
    linear-gradient(
      180deg,
      #e1f6e9 0%,
      #d2eedc 100%
    );
}

.mail-list {
  display: grid;
  gap: 0.5625rem;
}

.mail-pagination {
  display: grid;
  grid-template-columns:
    minmax(0, 1fr)
    auto
    minmax(0, 1fr);
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.75rem;
}

.mail-pagination__button {
  min-block-size: 2.25rem;
  padding: 0.375rem 0.75rem;
  border: 0.0625rem solid var(--color-line);
  border-radius: var(--radius-sm);
  color: #405584;
  background:
    linear-gradient(
      135deg,
      #eee8ff 0%,
      #e3efff 100%
    );
  font-size: var(--font-sm);
  font-weight: 750;
  cursor: pointer;
}

.mail-pagination__button:disabled {
  opacity: 0.4;
  cursor: default;
}

.mail-pagination__label {
  min-inline-size: 4.5rem;
  color: var(--color-text-soft);
  font-size: var(--font-sm);
  font-weight: 750;
  text-align: center;
  white-space: nowrap;
}

.mail-card {
  position: relative;
  overflow: hidden;
  display: block;
  padding: 0.6875rem 0.75rem 0.625rem 0.8125rem;
  border: 0.0625rem solid rgba(197, 206, 235, 0.82);
  border-radius: var(--radius-md);
  color: inherit;
  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.99) 0%,
      rgba(252, 252, 255, 0.98) 100%
    );
  box-shadow: 0 0.375rem 1rem rgba(148, 161, 206, 0.09);
  transition:
    transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
    border-color 0.28s ease,
    box-shadow 0.28s ease;
}

.mail-card:hover {
  border-color: var(--color-line-strong);
  box-shadow: var(--shadow-card);
}

.mail-card:active {
  transform: translateY(-0.0625rem) scale(0.995);
}

.mail-card.is-new {
  border-color: rgba(181, 193, 234, 0.9);
  background:
    linear-gradient(
      180deg,
      rgba(246, 249, 255, 0.99) 0%,
      rgba(252, 249, 255, 0.99) 100%
    );
}

.mail-card.is-hidden {
  display: none;
}

.mail-card__accent {
  position: absolute;
  inset: 0 auto 0 0;
  inline-size: 0.1875rem;
  background:
    linear-gradient(
      180deg,
      #ad91e8 0%,
      #7eade9 50%,
      #b3a0e8 100%
    );
}

.mail-card__head,
.mail-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}

.mail-card__head {
  margin-bottom: 0.4375rem;
}

.mail-card__foot {
  margin-top: 0.5rem;
}

.mail-card__badges {
  min-inline-size: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
}

.badge,
.state {
  min-block-size: 1.3125rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 0.4375rem;
  border-radius: var(--radius-pill);
  font-size: var(--font-2xs);
  font-weight: 750;
  line-height: 1;
  white-space: nowrap;
}

.badge--new {
  color: #7151a0;
  background:
    linear-gradient(
      180deg,
      #f3edff 0%,
      #e9e1ff 100%
    );
}

.badge--progress {
  color: var(--color-progress);
  background:
    linear-gradient(
      180deg,
      #fff7df 0%,
      #ffedc4 100%
    );
}

.badge--done {
  color: var(--color-done);
  background:
    linear-gradient(
      180deg,
      #edf9f1 0%,
      #def3e6 100%
    );
}

.badge--store {
  color: #75699a;
  background:
    linear-gradient(
      180deg,
      #ffffff 0%,
      #f4f0ff 100%
    );
}

.state--new {
  color: var(--color-new);
  background: var(--color-new-bg);
}

.state--progress {
  color: var(--color-progress);
  background: var(--color-progress-bg);
}

.state--done {
  color: var(--color-done);
  background: var(--color-done-bg);
}

.mail-card__time,
.mail-card__preview,
.assignee {
  color: var(--color-text-soft);
  font-size: var(--font-sm);
}

.mail-card__time {
  flex: 0 0 auto;
  white-space: nowrap;
}

.mail-card__body {
  min-inline-size: 0;
}

.mail-card__from {
  margin: 0 0 0.1875rem;
  overflow: hidden;
  color: #515879;
  font-size: var(--font-sm);
  font-weight: 750;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mail-card__subject {
  margin: 0 0 0.1875rem;
  overflow: hidden;
  color: var(--color-text-strong);
  font-size: 0.875rem;
  font-weight: 750;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mail-card__preview {
  display: -webkit-box;
  margin: 0;
  overflow: hidden;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-clamp: 2;
}

.mail-card__complete {
  padding: 0.25rem 0.625rem;
  border: 0.0625rem solid #96cbaa;
  border-radius: 999rem;
  color: #407359;
  background:
    linear-gradient(
      180deg,
      #e1f6e9 0%,
      #d2eedc 100%
    );
  font-size: var(--font-xs);
  font-weight: 800;
  cursor: pointer;
}

.mail-card__complete:hover {
  box-shadow: var(--shadow-soft);
}

.mail-card__completed {
  color: #407359;
  font-size: var(--font-sm);
  font-weight: 750;
}

.menu-backdrop {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(119, 132, 180, 0.18);
  opacity: 0;
  transition: opacity 0.46s cubic-bezier(0.22, 1, 0.36, 1);
}

.menu-backdrop.is-visible {
  opacity: 1;
}

.menu-panel {
  position: fixed;
  inset: 0 0 0 auto;
  z-index: 30;
  inline-size: min(78vw, 18.5rem);
  padding:
    max(0.875rem, env(safe-area-inset-top))
    0.875rem
    max(0.875rem, env(safe-area-inset-bottom));
  border-left: 0.0625rem solid var(--color-line);
  background:
    radial-gradient(
      circle at 90% 5%,
      rgba(222, 231, 255, 0.48),
      transparent 28%
    ),
    linear-gradient(
      180deg,
      #ffffff 0%,
      #f8f5ff 100%
    );
  box-shadow: var(--shadow-panel);
  transform: translateX(100%);
  transition: transform 0.58s cubic-bezier(0.22, 1, 0.36, 1);
}

.menu-panel.is-open {
  transform: translateX(0);
}

.menu-panel__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.75rem;
  margin-bottom: 0.75rem;
  padding-bottom: 0.6875rem;
  border-bottom: 0.0625rem solid rgba(196, 205, 235, 0.76);
}

.menu-panel__title-group {
  min-inline-size: 0;
}

.menu-panel__eyebrow,
.menu-panel__sub {
  margin: 0;
  color: #8379a6;
  font-size: var(--font-2xs);
  font-weight: 700;
  letter-spacing: 0.15em;
}

.menu-panel__title {
  margin: 0.125rem 0;
  color: #3c436e;
  font-size: 0.9375rem;
  font-weight: 800;
  letter-spacing: 0.07em;
}

.menu-list {
  display: grid;
  gap: 0.4375rem;
}

.menu-item {
  inline-size: 100%;
  min-block-size: 2.1875rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.625rem;
  padding: 0.5rem 0.625rem;
  border: 0.0625rem solid var(--color-line);
  border-radius: var(--radius-sm);
  color: #5e5689;
  background:
    linear-gradient(
      180deg,
      #ffffff 0%,
      #faf8ff 100%
    );
  box-shadow: 0 0.25rem 0.75rem rgba(149, 161, 205, 0.07);
  transition:
    transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
    border-color 0.25s ease,
    background 0.25s ease;
}

.menu-item:hover {
  border-color: var(--color-line-strong);
  background:
    linear-gradient(
      180deg,
      #ffffff 0%,
      #f3efff 100%
    );
}

.menu-item:active {
  transform: scale(0.985);
}

.menu-item__main {
  font-size: var(--font-sm);
  font-weight: 750;
}

.menu-item__sub {
  color: #8d84aa;
  font-size: var(--font-2xs);
}

.panel {
  padding: 0.75rem;
  border: 0.0625rem solid var(--color-line);
  border-radius: var(--radius-lg);
  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.99) 0%,
      rgba(249, 247, 255, 0.98) 100%
    );
  box-shadow: var(--shadow-card);
}

.detail-head {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
  margin-bottom: 0.5rem;
}

.detail-subject {
  margin: 0 0 0.75rem;
  color: var(--color-text-strong);
  font-size: 0.9375rem;
  font-weight: 750;
  line-height: 1.45;
}

.meta-list {
  display: grid;
  gap: 0;
  margin: 0 0 0.75rem;
  overflow: hidden;
  border: 0.0625rem solid rgba(199, 207, 235, 0.8);
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.7);
}

.meta-row {
  display: grid;
  grid-template-columns: 3.75rem minmax(0, 1fr);
  gap: 0.625rem;
  padding: 0.4375rem 0.5625rem;
  border-bottom: 0.0625rem solid rgba(211, 217, 239, 0.72);
}

.meta-row:last-child {
  border-bottom: 0;
}

.meta-row dt {
  color: var(--color-text-soft);
  font-size: var(--font-sm);
}

.meta-row dd {
  min-inline-size: 0;
  margin: 0;
  overflow-wrap: anywhere;
  color: var(--color-text);
  font-size: var(--font-sm);
}

.message-box {
  padding: 0.6875rem;
  border: 0.0625rem solid rgba(199, 208, 236, 0.82);
  border-radius: var(--radius-sm);
  color: var(--color-text);
